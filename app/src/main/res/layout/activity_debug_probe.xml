<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- 提示 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/card_dark">
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.4" />
    </androidx.cardview.widget.CardView>

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelayedDump"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="📸 抓取TikTok界面（3秒后）"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/tiktok_pink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickDump"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="📱 当前页"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/accent_blue" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="📋 复制结果"
            android:textSize="12sp"
            android:enabled="false"
            android:layout_marginEnd="6dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="6dp"
            app:strokeColor="@color/accent_blue"
            android:textColor="@color/accent_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveFile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💾 保存到文件"
            android:textSize="12sp"
            android:enabled="false"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="6dp"
            app:strokeColor="@color/accent_orange"
            android:textColor="@color/accent_orange" />
    </LinearLayout>

    <!-- 抓取结果区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/card_dark"
        android:padding="2dp">
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="抓取结果将在此显示..."
                android:textColor="#00FF88"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
