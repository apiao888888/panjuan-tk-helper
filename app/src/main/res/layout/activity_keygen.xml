<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 本机设备ID（参考） -->
        <TextView
            android:id="@+id/tvLocalDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本机设备码：-"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- 输入区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="生成授权码"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@color/section_header" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- 目标设备ID -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="目标设备码（客户的 Android ID）："
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etTargetDeviceId"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="粘贴客户的设备码"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:inputType="textCapCharacters"
                        android:background="@drawable/bg_input"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUseLocalDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="本机"
                        android:textSize="12sp"
                        app:cornerRadius="6dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/accent_blue"
                        android:textColor="@color/accent_blue" />
                </LinearLayout>

                <!-- 有效期选择 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="授权有效期："
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerValidity"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="14dp" />

                <!-- 生成按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="🔑  生成授权码"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/tiktok_pink" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 结果区域 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#0D2318">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✅ 授权码已生成"
                    android:textColor="@color/green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- 授权码大字显示 -->
                <TextView
                    android:id="@+id/tvGeneratedKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:background="@color/card_item"
                    android:padding="14dp"
                    android:layout_marginBottom="10dp" />

                <!-- 授权信息 -->
                <TextView
                    android:id="@+id/tvKeyInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="12dp" />

                <!-- 操作按钮行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyKey"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="📋 复制授权码"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="6dp"
                        app:backgroundTint="@color/btn_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerify"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="🔍 验证"
                        android:textSize="13sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="6dp"
                        app:strokeColor="@color/accent_blue"
                        android:textColor="@color/accent_blue" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 使用说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 使用说明\n\n① 让客户打开判官TK助手，复制其「设备码」\n② 将设备码粘贴到上方输入框\n③ 选择授权时长，点击「生成授权码」\n④ 复制生成的授权码发给客户\n⑤ 客户在激活界面输入即可使用\n\n⚠️ 授权码绑定设备，一机一码，不可转让"
            android:textColor="#555555"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
